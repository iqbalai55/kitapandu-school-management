# KSMA backend — local environment template
# Copy to .env and adjust.

KITAPANDU_ENV=development
KITAPANDU_LOG_LEVEL=INFO

# Postgres
KITAPANDU_POSTGRES_DSN=postgresql+asyncpg://ksma:ksma@localhost:5432/ksma
KITAPANDU_POSTGRES_DSN_SYNC=postgresql://ksma:ksma@localhost:5432/ksma

# JWT
KITAPANDU_JWT_SECRET=change-me-in-prod
KITAPANDU_JWT_ISSUER=kitapandu-api
KITAPANDU_JWT_AUDIENCE=kitapandu-web
KITAPANDU_ACCESS_TOKEN_TTL_SECONDS=900
KITAPANDU_REFRESH_TOKEN_TTL_SECONDS=604800

# MinIO (S3-compatible)
KITAPANDU_MINIO_ENDPOINT=localhost:9000
KITAPANDU_MINIO_ACCESS_KEY=minioadmin
KITAPANDU_MINIO_SECRET_KEY=minioadmin
KITAPANDU_MINIO_SECURE=false
KITAPANDU_S3_BUCKET=ksma-attachments
KITAPANDU_PRESIGNED_URL_TTL_SECONDS=300

# Outbox
KITAPANDU_OUTBOX_POLL_INTERVAL_SECONDS=0.5
KITAPANDU_OUTBOX_BATCH_SIZE=50

# File upload limits (NFR07)
KITAPANDU_MAX_FILE_BYTES=10485760

# Default tenant timezone (per docs)
KITAPANDU_DEFAULT_TIMEZONE=Asia/Jakarta